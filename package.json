{
  "name": "dsh-genbox-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness tools for GenBox: image generation/editing and video generation via a local GenBox server.",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir lib",
    "watch": "tsdown src/index.ts --format esm --dts --watch --out-dir lib",
    "prepare": "tsdown src/index.ts --format esm --dts --clean --out-dir lib",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
