{
  "name": "dsh-genbox-plugin",
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "description": "DeepSeek Harness tools for GenBox: image generation/editing (including inpaint, upscale, cutout) and video generation through a local GenBox server.",
  "license": "MIT",
  "author": "liwei9745",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "genbox",
    "cordis-plugin",
    "image-generation",
    "image-editing",
    "video-generation",
    "text-to-image",
    "inpainting"
  ],
  "homepage": "https://github.com/liwei9745/dsh-genbox-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liwei9745/dsh-genbox-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/liwei9745/dsh-genbox-plugin/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.1"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --out-dir lib",
    "watch": "tsdown src/index.ts --format esm --dts --watch --out-dir lib",
    "prepare": "tsdown src/index.ts --format esm --dts --clean --out-dir lib",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsdown src/index.ts --format esm --dts --clean --out-dir lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24.19.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  }
}
